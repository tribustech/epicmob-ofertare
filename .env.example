# Local dev: Docker Postgres (see npm run db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/epicmob?schema=public"

# Production (Vercel): set to the Railway Postgres PUBLIC url, e.g.
# DATABASE_URL="postgresql://postgres:PASSWORD@HOST.rlwy.net:PORT/railway?connection_limit=5"

# „Schiță → Ofertă" — Google Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
SCHITA_MODEL=gemini-3.6-flash
