# Local dev: Docker Postgres (see npm run db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/epicmob?schema=public"

# Production (Vercel): set to the Railway Postgres PUBLIC url, e.g.
# DATABASE_URL="postgresql://postgres:PASSWORD@HOST.rlwy.net:PORT/railway?connection_limit=5"

# „Schiță → Ofertă" — Google Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
SCHITA_MODEL=gemini-3.6-flash

# Auth — secretul de semnare al sesiunilor (min. 32 caractere): `openssl rand -base64 32`
AUTH_SECRET=

# Bot cheltuieli (Telegram) — botul se creează din @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=          # fără @, ex. EpicMobBonuriBot
TELEGRAM_WEBHOOK_SECRET=        # `openssl rand -hex 32`; înregistrare: npm run bot:webhook -- https://<domeniu>
# RECEIPT_MODEL=gemini-3.6-flash  # opțional; implicit SCHITA_MODEL

# Bucket S3-compatibil pe Railway (pozele bonurilor). Valorile sunt în tab-ul „Credentials" al bucket-ului.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true      # doar dacă endpoint-ul nu suportă virtual-hosted style
